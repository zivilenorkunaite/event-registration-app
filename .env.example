# Copy this file to .env for local backend settings:
# cp .env.example .env

# -----------------------------
# App behavior
# -----------------------------
# Event text shown on badge/preview
EVENT_NAME=Energy & Utilities Connect Sydney
EVENT_LOCATION=Sydney
NAMETAG_TEMPLATE_VERSION=2026-03-15

# -----------------------------
# Optional: Niimbot printing
# -----------------------------
# Leave empty to disable live printer calls (images still generated/saved)
NIIMBOT_SERVER_URL=http://localhost:5050
NIIMBOT_TRANSPORT=ble
NIIMBOT_ADDRESS=
NIIMBOT_PRINT_TASK=B1
NIIMBOT_LABEL_WIDTH_MM=50
NIIMBOT_LABEL_HEIGHT_MM=80

# -----------------------------
# Optional: Databricks SQL storage
# If unset, backend falls back to local JSON storage.
# -----------------------------
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CONFIG_PROFILE=default

# Optional advanced Databricks settings
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_VOLUME_PATH=/Volumes/main/default/name_tags

# -----------------------------
# Local agent (queue -> local printer)
# -----------------------------
LOCAL_AGENT_LOCAL_RUN=false
LOCAL_AGENT_LOCAL_QUEUE_FILE=app/backend/data/print_jobs.json
LOCAL_AGENT_QUEUE_TABLE=main.default.print_jobs
LOCAL_AGENT_PRINTER_ID=
LOCAL_AGENT_POLL_SECONDS=2
LOCAL_AGENT_CLAIM_TTL_SECONDS=30
LOCAL_AGENT_MAX_RETRY_BACKOFF_SECONDS=120
LOCAL_AGENT_DEFAULT_MAX_ATTEMPTS=5
LOCAL_AGENT_ID=onsite-agent-1
LOCAL_AGENT_AUTO_CONNECT=true
LOCAL_AGENT_REQUIRED_TEMPLATE_VERSION=2026-03-15

# Optional defaults if queue payload omits size/quantity
NIIMBOT_LABEL_WIDTH_PX=560
NIIMBOT_LABEL_HEIGHT_PX=320
NIIMBOT_DEFAULT_QUANTITY=1
NIIMBOT_PRINT_DIRECTION=top
NIIMBOT_ROTATE_PORTRAIT=true
NIIMBOT_ROTATED_X_OFFSET_PX=0
NIIMBOT_ROTATE_TEXT_90=false
