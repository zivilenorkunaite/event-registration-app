{
  "name": "event-registration-app",
  "version": "1.0.0",
  "description": "Event Registration App",
  "scripts": {
    "install:frontend": "cd frontend && npm install",
    "start:backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --app-dir .",
    "start:frontend": "cd frontend && npm run dev -- --host 0.0.0.0 --port 8080",
    "start": "npm run start:backend",
    "build": "cd frontend && npm install && npm run build"
  },
