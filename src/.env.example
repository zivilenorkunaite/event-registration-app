# Database Configuration (Required)
# These variables are required for the app to start
DB_USER=your_database_user
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_database_password
DB_PORT=5432

# Server Configuration (Optional - defaults to 8000)
PORT=8000

# Niimbot printer (optional - uses @mmote/niimbluelib via niimblue-node server)
# Run: npx niimblue-cli server (then connect to printer via CLI or /connect)
# NIIMBOT_SERVER_URL=http://localhost:5000
# NIIMBOT_TRANSPORT=serial
# NIIMBOT_ADDRESS=COM8
# NIIMBOT_PRINT_TASK=B1
